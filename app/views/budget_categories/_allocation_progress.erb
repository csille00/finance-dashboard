<%# locals: (budget:) %>

<div id="<%= dom_id(budget, :allocation_progress) %>" class="flex items-center justify-between gap-4 mb-6 bg-container shadow-border-xs rounded-lg p-4">
  <div class="text-sm">
    <p class="text-primary font-medium"><%= t("budget_categories.allocation_progress.total_label") %></p>
    <p class="text-secondary"><%= t("budget_categories.allocation_progress.total_hint") %></p>
  </div>

  <p class="text-primary text-xl font-medium privacy-sensitive"><%= format_money(budget.allocated_spending_money) %></p>
</div>
